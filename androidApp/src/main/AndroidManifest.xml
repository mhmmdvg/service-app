<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!--
      Receipt printing over Classic Bluetooth SPP. BLUETOOTH is install-time and only reaches API
      30; from 31 it is replaced by the runtime BLUETOOTH_CONNECT. neverForLocation opts out of the
      location permission that would otherwise be implied - the app connects to a device the user
      has already paired, and never scans.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
            android:usesPermissionFlags="neverForLocation"/>

    <application
            android:usesCleartextTraffic="true"
            android:allowBackup="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:name=".CashierServiceApplication"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Lets Play install the barcode scanner module ahead of the first scan. -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui"/>

        <activity
                android:exported="true"
                android:name=".MainActivity"
                tools:ignore="Instantiatable"
        >
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>

</manifest>